<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.javacw1601.controllers.MainController"
            prefHeight="600.0" prefWidth="900.0">
    <top>
        <VBox spacing="5" style="-fx-background-color: #f8f8f8; -fx-border-color: #d0d0d0; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets top="8" right="10" bottom="5" left="10"/>
            </padding>
            <Label text="Malabe Tuk-Tuk Spare Parts Depot"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <ToolBar style="-fx-background-color: transparent; -fx-padding: 0;">
                <Button text="Dashboard" onAction="#handleDashboard"/>
                <Button text="Inventory" onAction="#handleOpenFullInventory"/>
                <Button text="Dealers" onAction="#handleOpenDealer"/>
                <Button text="Cart" onAction="#handleOpenCart"/>
                <Button text="Audit Log" onAction="#handleOpenAuditLog"/>
                <Button text="Exit" onAction="#handleExit"/>
            </ToolBar>
        </VBox>
    </top>
    <center>
        <StackPane fx:id="contentArea">
            <VBox spacing="10.0">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>
                <HBox spacing="20.0" alignment="CENTER">
                    <VBox alignment="CENTER" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 10;">
                        <Label text="Total Items" style="-fx-font-weight: bold;"/>
                        <Label fx:id="lblTotalCount" text="0" style="-fx-font-size: 24px;"/>
                    </VBox>
                    <VBox alignment="CENTER" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 10;">
                        <Label text="Total Value" style="-fx-font-weight: bold;"/>
                        <Label fx:id="lblTotalValue" text="Rs. 0.00" style="-fx-font-size: 24px;"/>
                    </VBox>
                    <VBox alignment="CENTER" style="-fx-border-color: #ff6666; -fx-border-radius: 5; -fx-padding: 10;">
                        <Label text="Low Stock Items" style="-fx-font-weight: bold;"/>
                        <Label fx:id="lblLowStockCount" text="0" style="-fx-font-size: 24px; -fx-text-fill: #cc0000;"/>
                    </VBox>
                </HBox>
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Label text="Low Stock Threshold:"/>
                    <TextField fx:id="txtThreshold" prefWidth="60" text="5"/>
                    <Button text="Apply" onAction="#handleApplyThreshold"/>
                </HBox>
                <TableView fx:id="lowStockTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colImage" text="Image" prefWidth="80"/>
                        <TableColumn fx:id="colCode" text="Code" prefWidth="80"/>
                        <TableColumn fx:id="colName" text="Name" prefWidth="150"/>
                        <TableColumn fx:id="colBrand" text="Brand" prefWidth="100"/>
                        <TableColumn fx:id="colPrice" text="Price" prefWidth="100"/>
                        <TableColumn fx:id="colCategory" text="Category" prefWidth="120"/>
                        <TableColumn fx:id="colQuantity" text="Qty" prefWidth="60"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </StackPane>
    </center>
</BorderPane>