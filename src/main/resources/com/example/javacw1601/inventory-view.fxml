<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.javacw1601.controllers.InventoryController"
            prefHeight="600.0" prefWidth="900.0">
    <children>
        <VBox spacing="10.0" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="Full Inventory" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <ToolBar>
                <Button text="Refresh" onAction="#handleRefresh"/>
                <Button text="Add Item" onAction="#handleOpenAddItem"/>
                <Button text="Update Item" onAction="#handleOpenUpdateItem"/>
                <Button text="Delete Item" onAction="#handleDeleteItem"/>
            </ToolBar>

            <TableView fx:id="inventoryTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colImage" text="Image" prefWidth="80"/>
                    <TableColumn fx:id="colCode" text="Code" prefWidth="80"/>
                    <TableColumn fx:id="colName" text="Name" prefWidth="150"/>
                    <TableColumn fx:id="colBrand" text="Brand" prefWidth="100"/>
                    <TableColumn fx:id="colPrice" text="Price" prefWidth="100"/>
                    <TableColumn fx:id="colCategory" text="Category" prefWidth="120"/>
                    <TableColumn fx:id="colQuantity" text="Qty" prefWidth="60"/>
                    <TableColumn fx:id="colThreshold" text="Threshold" prefWidth="70"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <HBox spacing="20.0" alignment="CENTER_LEFT">
                <Label fx:id="lblTotalCount" text="Total Items: 0"/>
                <Label fx:id="lblTotalValue" text="Total Value: Rs. 0.00"/>
                <Label fx:id="lblLowStockCount" text="Low Stock: 0"/>
            </HBox>

            <HBox spacing="10.0" alignment="CENTER_RIGHT">
                <Button text="Close" onAction="#handleClose"/>
            </HBox>
        </VBox>
    </children>
</AnchorPane>
