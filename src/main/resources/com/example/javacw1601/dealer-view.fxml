<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.javacw1601.controllers.DealerController"
            prefHeight="600.0" prefWidth="800.0">
    <children>
        <VBox spacing="10.0" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="Dealer Management" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>


            <TableView fx:id="dealerTable" VBox.vgrow="ALWAYS" prefHeight="200.0">
                <columns>
                    <TableColumn fx:id="colDealerCode" text="Code" prefWidth="80"/>
                    <TableColumn fx:id="colDealerName" text="Name" prefWidth="150"/>
                    <TableColumn fx:id="colDealerPhone" text="Phone" prefWidth="120"/>
                    <TableColumn fx:id="colDealerLocation" text="Location" prefWidth="150"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>


            <GridPane hgap="10.0" vgap="10.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="80" prefWidth="80"/>
                    <ColumnConstraints minWidth="150" prefWidth="150"/>
                    <ColumnConstraints minWidth="80" prefWidth="80"/>
                    <ColumnConstraints minWidth="150" prefWidth="150"/>
                </columnConstraints>

                <Label text="Code:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="txtDealerCode" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="txtDealerName" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Phone:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <TextField fx:id="txtDealerPhone" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                <Label text="Location:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <TextField fx:id="txtDealerLocation" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
            </GridPane>


            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Button text="Add Dealer" onAction="#handleAddDealer"/>
                <Button text="Update Dealer" onAction="#handleUpdateDealer"/>
                <Button text="Delete Dealer" onAction="#handleDeleteDealer"/>
                <Button text="Clear Form" onAction="#handleClearForm"/>
            </HBox>

            <Label fx:id="lblDealerError" textFill="red" wrapText="true"/>

            <Separator/>

            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Button text="Pick 4 Random Dealers" onAction="#handleRandomDealers"/>
            </HBox>
            <ListView fx:id="lstRandomDealers" prefHeight="100.0"/>

            <HBox spacing="10.0" alignment="CENTER_RIGHT">
                <Button text="Close" onAction="#handleClose"/>
            </HBox>
        </VBox>
    </children>
</AnchorPane>