<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.javacw1601.controllers.DealerController"
            prefHeight="600.0" prefWidth="800.0">
    <children>
        <VBox spacing="10.0" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="Dealer Directory" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Label text="Dealers are reference data loaded from the legacy dealer file (read-only)." style="-fx-font-style: italic;"/>

            <TableView fx:id="dealerTable" VBox.vgrow="ALWAYS" prefHeight="250.0">
                <columns>
                    <TableColumn fx:id="colDealerCode" text="Code" prefWidth="80"/>
                    <TableColumn fx:id="colDealerName" text="Name" prefWidth="180"/>
                    <TableColumn fx:id="colDealerPhone" text="Phone" prefWidth="120"/>
                    <TableColumn fx:id="colDealerLocation" text="Location" prefWidth="150"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <Label fx:id="lblDealerCount" text="Total Dealers: 0"/>

            <Separator/>

            <Label text="Pick 4 unique dealers at random, sorted alphabetically by location:" style="-fx-font-weight: bold;"/>
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Button text="Pick 4 Random Dealers" onAction="#handleRandomDealers"/>
            </HBox>
            <Label fx:id="lblDealerError" textFill="red" wrapText="true"/>
            <ListView fx:id="lstRandomDealers" prefHeight="120.0"/>

            <HBox spacing="10.0" alignment="CENTER_RIGHT">
                <Button text="Close" onAction="#handleClose"/>
            </HBox>
        </VBox>
    </children>
</AnchorPane>
