<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.javacw1601.controllers.CartController"
            prefHeight="500.0" prefWidth="700.0">
    <children>
        <VBox spacing="10.0" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="Shopping Cart" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Label text="Item Code:"/>
                <TextField fx:id="txtCartItemCode" prefWidth="100"/>
                <Label text="Qty:"/>
                <TextField fx:id="txtCartQuantity" prefWidth="60"/>
                <Button text="Add to Cart" onAction="#handleAddToCart"/>
            </HBox>

            <TableView fx:id="cartTable" VBox.vgrow="ALWAYS" prefHeight="200.0">
                <columns>
                    <TableColumn fx:id="colCartCode" text="Code" prefWidth="80"/>
                    <TableColumn fx:id="colCartName" text="Name" prefWidth="150"/>
                    <TableColumn fx:id="colCartQty" text="Qty" prefWidth="60"/>
                    <TableColumn fx:id="colCartPrice" text="Unit Price" prefWidth="100"/>
                    <TableColumn fx:id="colCartTotal" text="Total" prefWidth="100"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Button text="Remove Selected" onAction="#handleRemoveFromCart"/>
                <Button text="Clear Cart" onAction="#handleClearCart"/>
                <Button text="Update Quantity" onAction="#handleUpdateQuantity"/>
            </HBox>

            <HBox spacing="20.0" alignment="CENTER_LEFT">
                <Label fx:id="lblCartTotal" text="Total: Rs. 0.00" style="-fx-font-weight: bold;"/>
                <Button text="Checkout" onAction="#handleCheckout"/>
                <Button text="Close" onAction="#handleCloseCart"/>
            </HBox>

            <Label fx:id="lblCartError" textFill="red" wrapText="true"/>
        </VBox>
    </children>
</AnchorPane>