<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.javacw1601.controllers.AddItemController"
            prefHeight="450.0" prefWidth="500.0">
    <children>
        <VBox spacing="15.0" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Add New Spare Part" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <GridPane hgap="10.0" vgap="10.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="100" prefWidth="100"/>
                    <ColumnConstraints minWidth="200" prefWidth="300"/>
                </columnConstraints>

                <Label text="Code:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="txtCode" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="txtName" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Brand:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="txtBrand" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Price (Rs.):" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="txtPrice" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Quantity:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <TextField fx:id="txtQuantity" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                <Label text="Category:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                <ComboBox fx:id="cmbCategory" editable="true" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                <Label text="Date Added:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                <DatePicker fx:id="dpDate" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

                <Label text="Image Filename:" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
                <TextField fx:id="txtImage" GridPane.columnIndex="1" GridPane.rowIndex="7"/>
            </GridPane>

            <Label fx:id="lblError" textFill="red" wrapText="true"/>

            <HBox spacing="15.0" alignment="CENTER_RIGHT">
                <Button text="Save" onAction="#handleSave"/>
                <Button text="Cancel" onAction="#handleCancel"/>
            </HBox>
        </VBox>
    </children>
</AnchorPane>